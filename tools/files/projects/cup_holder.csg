      "title": "Main",
      "content": "/*\nscrew\n  length .2292 5.8mm so 6mm\n  head height 0.0748 1.899 so 2mm\n  head diameter 0.2182 so 5.6 mm\n  diameter 0.1156 so 3mm\nnut\n  height 0.09 is 2.28mm\n  nut corners length diameter 0.245 6.223mm\n\n\n\n//*/\n\n\n\n\n\n\nvar tol= 0.2\nvar wall=5// wall thickness\nvar bolt={\n\td:3+0.2,\n\thtd:5.6+0.2,\n\thbd:3+0.2,\n\thh: 2\n}\n\n\nvar base={\n\td:3.8*inch,\n\tconeTop:3*inch,\n\tconeBottom: 3.4*inch,\n\tconeHeight:3*inch\n};\n\n\nvar cup = {\n\td:3.5*inch,\n\th:3*inch\n\n}\n\n\nvar baseCone= cylinder({\n\t\tdb:base.coneTop,\n\t\tdt:base.coneBottom,\n\t\th:base.coneHeight,\n\t\tfn:200\n\t})\n\n\nvar middleCone= cylinder({\n\t\tdb:base.coneBottom,\n\t\tdt:cup.d+ wall*2,\n\t\th:5, fn:200\n\t})\n\t\n\t\nvar tc1= cylinder({\n\t\td:cup.d+wall*2,\n\t\th:cup.h,\n\t\tfn:200\n\t})\nvar tc2=cylinder({\n\t\td:cup.d,\n\t\th:cup.h+2,\n\t\tfn:200\n\t})\n\t\nvar topCone= difference(tc1,tc2)\n\n\nplacement({ccx:0, ccy:0, tbz:-0.01},\n\tbaseCone, middleCone\n);\n\nplacement({ccx:0, ccy:0, tbz:-0.01}, middleCone, topCone)\n\nreturn floor(union(baseCone, middleCone, topCone));\n\n\n\n////////////\n\n\nvar nut={\n\th:2.228,\n\td:6.223+0.4,\n\tdh:6.223*0.2,\n\tc:6,//count\n\tsd:3+0.2\n\n}\n\n\n/////////////////////////\n\n\n\nvar basePlate= align({cx:0,cy:0,bz:0},\n\tcylinder({d:base.coneBottom, h:3, fn:200})\n)\n\n\n\nvar nuts =[];\nvar nuts1=[];\nvar bolts= [];\nvar boltTops=[];\n\nvar ang = 360/nut.c;\n\nfor(var i= 0; i< nut.c;i++)\n{\n\n\tvar n= cylinder({\n\t\t\td:nut.d, fn:6, h:nut.h\n\t\t})\n\tvar n1= cylinder({\n\t\t\td:nut.d+3, fn:6, h:nut.h\n\t\t})\n\n\tvar b= cylinder({\n\t\t\td:nut.sd,\n\t\t\th:10\n\t\t})\n\tvar bt= cylinder({\n\t\t\tdt:bolt.htd,\n\t\t\tdb:bolt.hbd,\n\t\t\th:bolt.hh\n\t\t})\n\n\n\tplacement({ccx:0, ccy:0, ttz:1},basePlate, n,b, n1);\n\n\tplacement({ccx:0, ccy:0, ttz:0},basePlate, bt);\n\n\n\n\ttranslate([base.coneBottom/2-10,0,0],n, b, n1, bt);\n\ttranslate([0,0,-2],b)\n\trotate([0, 0, ang*i],n,b, n1, bt);\n\n\tnuts.push(n)\n\tbolts.push(b)\n\tnuts1.push(n1)\n\tboltTops.push(bt)\n}\nnuts = union(nuts)\nnuts1= union(nuts1)\ntranslate([0,0,-0.01], nuts1)\n\n\nvar baseConeOutter=align({cx:0,cy:0,bz:0},cylinder({dt:base.coneTop, db:base.coneBottom, fn:200, h:base.coneHeight}));\nvar baseConeInner=align({cx:0,cy:0,bz:-0.001},cylinder({dt:base.coneTop-wall*2, db:base.coneBottom-wall*2, fn:200, h:base.coneHeight+0.002}))\n\nalign({cx:0,cy:0,bz:3}, baseConeOutter,baseConeInner);\n\n\nbasePlate= difference(\n\tunion(basePlate, nuts1, baseConeOutter),\n\tnuts, bolts, baseConeInner\n);\n\n\nvar cupTop= align({cx:0,cy:0,bz:0},\n\tcylinder({d:cup.d+wall*2, h:cup.h+3, fn:200})\n)\nvar cupInner=align({cx:0,cy:0,bz:3},\n\tcylinder({d:cup.d, h:cup.h+3, fn:200})\n)\n\nplacement({ccx:0, ccy:0, bbz:0.001}, [cupTop, boltTops]);\n\n\ncupTop=difference(cupTop, cupInner, bolts, boltTops);\n\n//rotate([180,0,1],basePlate)\n//placement({ccx:0, ccy:0, btz:0}, cupTop, basePlate);\n\n\nreturn basePlate//, cupTop];\n\n\n\n\n\n\n\n\n\n\n/*\n\n{\n\tvar ntest=cylinder({d:nut.d+1.5,h:nut.h+1.5, fn:6})\n\tvar ntestc =cylinder({d:nut.d,h:nut.h+1, fn:6})\n\tplacement({ccx:0,ccy:0, ttz:0.01}, ntest, ntestc)\n\tvar sc = cylinder({d:nut.sd,fn:50, h:10})\n\treturn difference(ntest,ntestc, sc);\n}\n\n\n//*/\n\n"
    },
