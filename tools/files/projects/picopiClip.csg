{
  "csgCode": [
    {
      "title": "single clip",
      "content": "\n\nvar tol= 0.1;\nvar wireDiamater = 1.0;\nvar boardThick = 1.5;\n\nvar boardDepth = 2.54\nvar length= 5;\n\n\nvar pitch=2.53;\nvar padding= 1;\n\nvar wireExpose=0.7\n\n////////////////////////\n\n\nvar d = wireDiamater;\nvar r = d/2;\n\nvar wireShape= new Path2d()\n.fn(50)\n.m(0,-r)\n.xr(r,r, 0,d)\n.xr(-r,-r,0,-d)\n\nvar wirePath=new Path3d()\n.m(0,0,0)\n.lr(0,length+boardThick, 0)\n.qr(0,r+tol,0, 0,r+tol,r+tol)\n.lr(0,0,boardThick)\n\nvar wireThruPath= new Path3d()\n.m(0,0,0)\n.lr(0,boardThick+d, 0)\n\nvar wire = extrude3d(wireShape, wirePath);\nvar wireThru=extrude3d(wireShape, wireThruPath);\n\nvar casing = cube([pitch-tol*2, boardDepth+length, padding *2+ boardThick+d])\n\nplacement({ccx:0, uuy:padding, bbz:-padding}, wire, casing);\nplacement({ccx:0, udy:-d,bbz:0}, wire, wireThru);\n\n\nvar cutout=cube([pitch+0.002, boardDepth+padding, boardThick+tol])\n\nplacement({ccx:0, uuy:0.001, bbz:padding+d-wireExpose}, casing, cutout);\n\nreturn [difference(casing, wire, wireThru, cutout)]\n\n\n\n//*/\n\n\n\n\n\n"
    },
    {
      "title": "wite strightener",
      "content": "\n\n\n\nvar sec={\n\tw:14,\n\th:11.3,\n\trollD:3,\n\tl:3*2+2*2\n}\n\n/////============================\nfunction secbar()\n{\n\tvar b=cube([sec.w, sec.l, sec.h])\n\talign({cx:0,cy:0,bz:0},b);\n\n\tvar c1=cylinder({d:3, h:10, fn:60});\n\tvar c2=cylinder({d:3, h:10, fn:60});\n\n\n\talign({cx:0, cy:0, bz:-3},c1);\n\talign({cx:0, cy:0, bz:-3},c2);\n\n\trotate([0,45,0],c1);\n\trotate([0,-45,0],c2)\n\n\tplacement({ccx:0,ddy:2, bbz:2}, b, c1)\n\tplacement({ccx:0,uuy:-2, bbz:2}, b, c2)\n\n\tvar cut = cube([10, 10, 10])\n\trotate([0,45,0], cut);\n\tplacement({ccx:0, ccy:0, bbz:7.5}, b, cut)\n\n\n\n\n\treturn difference(b,c1,c2, cut)\n\t//*/\n}\n\n\nvar s1= secbar()\n\nvar s2= secbar()\n\nplacement({ccx:0, udy:sec.l+0.2, bbz:0},s1,s2);\n\n\nvar s=[s1,s2];\n\nfunction outer()\n{\n\tvar w=sec.w+2*2;\n\tvar l= sec.l*4+2*2+ 0.2*4;\n\t\n\tvar o1 = cube([w,l, 7])\n\tvar in1 = cube([w-4,l-4, 7]);\n\tplacement({ccx:0, ccy:0, bbz:2}, o1, in1)\n\treturn difference(o1, in1);\n}\n\nvar out1=outer();\nplacement({ccx:0, ddy:-2, bbz:0}, s, out1);\nreturn union(s, out1)\n"
    }
